# ============================================================
# 环境变量示例 —— 复制为 .env 或在部署平台（Vercel/Netlify）配置
# 构建脚本只需 Node 18+ 内置能力，无需安装任何依赖。
#
# 注意：tools/build.js 会自动加载项目根目录的 .env 文件（零依赖实现）。
#      已在 process.env 中显式设置的变量优先，不会被 .env 覆盖，
#      因此 CI / 部署平台的环境变量配置依然有效。
# ============================================================

# Notion 集成 Token（留空 = 自动降级为 data/site-data.local.json）
# 获取方式：https://www.notion.so/my-integrations → 新建集成 → 复制 Internal Integration Secret
# 重要：还需在 Notion 中把目标页面/数据库「连接」到该集成，否则 API 会返回 404。
NOTION_TOKEN=

# 站点绝对地址（用于 OG 卡片、canonical、robots/sitemap 的绝对 URL）
# Vercel 会自动注入 VERCEL_URL；Netlify 会自动注入 URL；未配置时回退 https://example.com
SITE_URL=

# 可选：强制禁用 Notion 同步（等价于 --no-notion 参数）
# 取值 "1" 时视为禁用
NO_NOTION=
