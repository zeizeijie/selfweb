<!-- 图书馆列表：intro + 状态筛选芯片 + 2 列书籍网格 -->
<view class="library page">
  <empty-state wx:if="{{ !ready }}" type="error" text="数据加载失败，请重进小程序" />

  <block wx:else>
    <view class="head">
      <view class="eyebrow">LIBRARY</view>
      <view class="h1">图书馆</view>
      <view wx:if="{{ intro }}" class="lead head-intro">{{ intro }}</view>
    </view>

    <view wx:if="{{ years.length }}" class="years">
      <view
        wx:for="{{ years }}"
        wx:key="year"
        class="year-card {{ activeYear === item.year ? 'active' : '' }}"
        data-year="{{ item.year }}"
        bindtap="onToggleYear"
      >
        <view class="yc-head">
          <text class="yc-num">{{ item.year }}</text>
          <text class="yc-summary {{ item.done ? 'done' : '' }}">{{ item.summary }}</text>
        </view>
        <view class="yc-stats">
          <text>{{ item.goalText }}</text>
          <text>已读 {{ item.read }} 本</text>
          <text>收录 {{ item.total }} 本</text>
        </view>
        <view class="yc-bar">
          <view class="yc-fill {{ item.done ? 'done' : '' }}" style="width: {{ item.percent }}%;"></view>
        </view>
      </view>
    </view>

    <view class="chips-wrap">
      <chip-bar items="{{ chips }}" active="{{ filter }}" bind:pick="onChip" />
    </view>

    <empty-state
      wx:if="{{ books.length === 0 }}"
      type="empty"
      text="这个筛选下还没有书"
      action-label="查看全部"
      bind:action="onEmptyAction"
    />

    <view wx:else class="grid-2 book-grid">
      <reveal wx:for="{{ books }}" wx:key="id" delay="{{ index * 40 }}">
        <book-card book="{{ item }}" bind:tap="onTapBook" />
      </reveal>
    </view>
  </block>
</view>
