<!-- 文章详情：分类标签 + 标题 + 阅读时长 + 结构化正文 -->
<view class="article-detail page">
  <empty-state
    wx:if="{{ ready && notFound }}"
    type="error"
    text="没有找到这篇文章（id 无效或已移除）"
    bind:retry="onRetry"
  />

  <view wx:elif="{{ !ready }}" class="loading">
    <view class="skeleton sk-line" style="width: 30%"></view>
    <view class="skeleton sk-line" style="width: 80%; height: 56rpx"></view>
    <view class="skeleton sk-line" style="width: 100%; height: 200rpx"></view>
  </view>

  <block wx:else>
    <view class="a-head">
      <text wx:if="{{ catName }}" class="cat-tag">{{ catName }}</text>
      <view class="a-title">{{ article.title }}</view>
      <view class="a-meta">
        <text>{{ article.readingTime }}</text>
        <text class="a-from">来自个人 Notion 笔记</text>
      </view>
      <view wx:if="{{ article.summary }}" class="a-summary">{{ article.summary }}</view>
    </view>

    <view class="a-body">
      <block wx:for="{{ body }}" wx:key="index">
        <!-- 二级标题 -->
        <view wx:if="{{ item.kind === 'h2' }}" class="a-h2">{{ item.text }}</view>

        <!-- 段落 -->
        <rich-text wx:elif="{{ item.kind === 'p' }}" class="a-p" nodes="{{ item.nodes }}"></rich-text>

        <!-- 列表项 -->
        <view wx:elif="{{ item.kind === 'li' }}" class="a-li">
          <text class="bullet">•</text>
          <rich-text class="a-li-text" nodes="{{ item.nodes }}"></rich-text>
        </view>

        <!-- 引用块 -->
        <view wx:elif="{{ item.kind === 'quote' }}" class="a-quote">
          <rich-text class="a-quote-text" nodes="{{ item.nodes }}"></rich-text>
          <text wx:if="{{ item.source }}" class="bq-src">—— {{ item.source }}</text>
        </view>
      </block>
    </view>
  </block>
</view>
