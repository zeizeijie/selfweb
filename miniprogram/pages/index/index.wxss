/* 首页样式（对齐网站 hero + Bento 模块卡） */
.home {
  padding-bottom: 80rpx;
}

/* ---------- Hero ---------- */
.hero {
  padding: 88rpx var(--gap-page) 24rpx;
}
.hero-title {
  margin-top: 20rpx;
}
.hero-sub {
  margin-top: 24rpx;
}
.hero-tag {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ---------- 统计 ---------- */
.stats {
  margin-top: 48rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 40rpx 56rpx;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}
.stat-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ---------- 模块卡 ---------- */
.grid-modules {
  padding: 24rpx var(--gap-page) 0;
}
.module-card {
  background: var(--bg-alt);
  border-radius: var(--radius-l);
  padding: 48rpx 44rpx 40rpx;
  margin-bottom: 32rpx;
}
.module-card--hover {
  opacity: 0.92;
}
.mc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mc-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.mc-count {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}
.mc-name {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}
.mc-tag {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.mc-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}
.mc-foot {
  margin-top: 28rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.mc-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.mc-arrow {
  margin-left: auto;
  color: var(--blue);
}

/* ---------- 页脚 ---------- */
.foot {
  padding: 48rpx var(--gap-page) 0;
}
.foot-line {
  height: 1px;
  background: var(--line);
  margin-bottom: 32rpx;
}
.foot-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
}
.foot-owner {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
