/* 书籍卡片样式（对齐网站 .book） */
.book-card {
  display: block;
}

.book-card--hover {
  opacity: 0.9;
}

.cover {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4.3;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--bg-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, .13);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.fallback-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 32rpx;
  line-height: 1.4;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, .28);
}

.badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .9);
  color: var(--text);
  font-weight: 500;
}

.b-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.35;
}

.b-author {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.b-stars {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--star);
  letter-spacing: 2rpx;
}

.b-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--blue);
}
