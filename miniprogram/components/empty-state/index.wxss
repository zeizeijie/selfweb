/* 空态 / 错误态（对齐网站 .empty-state / .error-state） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 120rpx 48rpx;
  text-align: center;
}

.state-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  letter-spacing: -0.01em;
  line-height: 1.6;
}

.state-btn {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--blue);
  background: rgba(0, 113, 227, .1);
  border-radius: 999rpx;
  padding: 0 40rpx;
  line-height: 2.4;
  margin: 0;
}

.state-btn::after {
  border: none;
}

.state-btn--primary {
  color: #fff;
  background: var(--blue);
}
